		"@turf/turf": "^7.2.0",
		"@types/d3-color": "^3.1.3",
		"@types/eslint": "^9.6.1",
		"@types/geojson": "^7946.0.16",
		"eslint": "^9.30.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
